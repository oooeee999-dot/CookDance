---
import { ArrowUpRight, ArrowUp } from '@lucide/astro';
import { withBase } from '../lib/urls';
import { brand } from '../data/creative';
---
<footer id="connect" class="p-personal-footer" aria-label="Our philosophy and contact">
  <div class="footer-content">
    <section class="footer-philosophy" aria-labelledby="footer-philosophy-title">
      <span class="footer-label">CAPABILITY × VITALITY</span>
      <h2 id="footer-philosophy-title">Ideas need capability.<br />Creativity needs life.</h2>
      <p>Cook stands for capability. Dance stands for vitality. We connect China’s creative and manufacturing capabilities with people around the world. Today, that starts with AI video and digital creative production.</p>
      <span class="footer-slogan">{brand.slogan}</span>
    </section>
    <section class="footer-contact" aria-labelledby="footer-contact-title">
      <h2 id="footer-contact-title">Let’s create together.</h2>
      <a href={`mailto:${brand.email}`}>
        <span><span class="footer-label">EMAIL</span><span class="footer-contact-value">{brand.email}</span></span>
        <ArrowUpRight size={17} stroke-width={1.5} aria-hidden="true" />
      </a>
      <a href={brand.whatsapp} target="_blank" rel="noopener noreferrer">
        <span><span class="footer-label">WHATSAPP</span><span class="footer-contact-value">{brand.whatsappLabel}</span></span>
        <ArrowUpRight size={17} stroke-width={1.5} aria-hidden="true" />
      </a>
    </section>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} CookDance</span>
    <nav aria-label="Footer navigation">
      <a href={withBase('/about/')}>About CookDance <ArrowUpRight size={12} aria-hidden="true" /></a>
      <a href="#top">Back to top <ArrowUp size={12} aria-hidden="true" /></a>
    </nav>
  </div>
</footer>

<style>
  .p-personal-footer {
    scroll-margin-top: 128px;
    max-width: 1920px;
    margin: 14px auto 0;
    padding: 54px 32px 24px;
    border-top: 1px solid var(--p-line);
    color: var(--p-ink);
  }
  .footer-content {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: clamp(40px, 8vw, 130px);
    max-width: 1280px;
    margin: 0 auto 48px;
  }
  .footer-label { display: block; font-size: 10px; font-weight: 500; letter-spacing: .13em; line-height: 1.6; color: #747866; }
  .footer-philosophy h2 { font-family: Georgia, serif; font-size: clamp(29px, 3vw, 39px); font-weight: 400; line-height: 1.2; letter-spacing: -1.1px; margin: 15px 0 18px; }
  .footer-philosophy p { max-width: 590px; font-size: 14px; line-height: 1.9; color: #646e5e; margin: 0; }
  .footer-slogan { display: block; margin-top: 21px; font-family: Georgia, serif; font-style: italic; font-size: 17px; line-height: 1.5; color: #53634c; }
  .footer-contact { padding-top: 2px; }
  .footer-contact h2 { font-family: Georgia, serif; font-size: 24px; font-weight: 400; letter-spacing: -.5px; line-height: 1.3; margin: 0 0 14px; }
  .footer-contact > a { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 15px 0 17px; border-bottom: 1px solid var(--p-line); }
  .footer-contact > a:hover .footer-contact-value { text-decoration: underline; text-underline-offset: 4px; }
  .footer-contact > a > span { min-width: 0; }
  .footer-contact > a > svg { flex-shrink: 0; }
  .footer-contact-value { display: block; margin-top: 5px; font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; }
  .footer-bottom { max-width: 1280px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid var(--p-line); padding-top: 21px; font-size: 11px; line-height: 1.6; color: #737b6c; }
  .footer-bottom nav { display: flex; gap: 27px; }
  .footer-bottom a { display: inline-flex; align-items: center; gap: 6px; }
  .footer-bottom a:hover { color: var(--p-ink); }
  @media (max-width: 700px) {
    .p-personal-footer { margin-top: 10px; padding: 38px 22px 24px; }
    .footer-content { grid-template-columns: 1fr; gap: 32px; margin-bottom: 31px; }
    .footer-philosophy h2 { margin-top: 13px; }
    .footer-philosophy p { font-size: 14px; line-height: 1.85; }
    .footer-contact h2 { font-size: 23px; }
    .footer-contact-value { font-size: 14px; }
    .footer-bottom { flex-wrap: wrap; gap: 15px; font-size: 10px; }
    .footer-bottom nav { gap: 20px; }
  }
</style>
