---
import { Bookmark } from '@lucide/astro';
import { storyHref, coverRatio, type Story } from '../demo/content';
import { withBase } from '../lib/urls';
import { cardColors, cardRatio, cardDestination, mediaSource, type DisplayCard } from '../data/creative';
interface Props { story?: Story; card?: DisplayCard; index?: number; saveable?: boolean; }
const { story, card, index = 0, saveable = true } = Astro.props;
if (!story && !card) throw new Error('PlatformPin requires a card or story.');
const id = card?.id ?? story!.id;
const title = card?.title ?? story!.title;
const image = card ? mediaSource(card.image) : story!.image;
const destination = card ? cardDestination(card) : storyHref(id);
const href = destination.startsWith('/') ? withBase(destination) : destination;
const colors = card ? cardColors(card) : undefined;
const ratio = card ? cardRatio(card) : coverRatio(story!.image);
---
<article class:list={['p-pin', { 'p-creative-card': !!card }]} data-story-id={!card ? id : undefined} data-card-id={card ? id : undefined} data-size={card?.sizeVariant} data-has-image={image ? 'true' : 'false'} data-position={card?.textPosition ?? 'bottom-left'} data-type-style={card?.typeStyle ?? 'serif'} style={`--photo-ratio:${ratio};${colors ? `--card-background:${colors.background};--card-color:${colors.color};--card-image-color:${card?.textColor ? colors.color : '#ffffff'};` : ''}`}>
  <a class="p-pin-link" href={href} aria-label={`Explore: ${title.replace(/\n/g, ' ')}`}>
    {image && <img src={image.startsWith('/') ? withBase(image) : image} alt={card?.imageAlt ?? story?.imageAlt ?? ''} width="800" height="1000" loading={index < 4 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} data-card-media={card ? '' : undefined} />}
    {card ? <><span class="p-card-kind">{card.kind}</span><div class="p-card-copy"><span class="p-card-category">{card.category}</span><h2>{title}</h2>{card.subtitle && <p>{card.subtitle}</p>}</div></> : <h2 class="p-sr-only">{title}</h2>}
  </a>
  {saveable && <button class="p-pin-save" data-save={!card ? id : undefined} data-creative-save={card ? id : undefined} aria-label={`Save ${title.replace(/\n/g, ' ')}`} aria-pressed="false"><Bookmark size={20} stroke-width={1.6} /></button>}
</article>
