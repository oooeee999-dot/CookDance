---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';
interface Props { article: CollectionEntry<'articles'>; index?: number; }
const { article, index = 0 } = Astro.props;
---
<article class="article-card">
  <a class="card-image" href={withBase(`/articles/${article.id}`)} aria-label={`Read ${article.data.title}`}>
    <img src={withBase(article.data.image)} alt={article.data.imageAlt} loading={index > 1 ? 'lazy' : 'eager'} />
  </a>
  <div class="card-meta"><span>{article.data.section} / {article.data.category}</span><span>{article.data.readTime}</span></div>
  <h3><a href={withBase(`/articles/${article.id}`)}>{article.data.title}</a></h3>
  <p>{article.data.description}</p>
  <a class="text-link" href={withBase(`/articles/${article.id}`)}>Read article <span aria-hidden="true">↗</span></a>
</article>
