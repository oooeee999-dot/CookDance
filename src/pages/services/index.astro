---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import ServiceCatalog from '../../components/ServiceCatalog.astro';
import { withBase } from '../../lib/urls';
import { ArrowUpRight } from '@lucide/astro';
---
<PlatformLayout title="Creative, technical & business services" description="Explore 13 service categories with CookDance. Bring us your creative, technical, or business idea, and let’s work towards a thoughtful delivery." image="/images/services/brand-design.webp">
  <header class="c-page-heading c-wide e-directory-header"><span class="p-eyebrow">EXPLORE COOKDANCE SERVICES</span><h1>More possibilities.<br /><em>One place to begin.</em></h1><p>Creative, technical, and business services for global clients. Bring us your idea. We’ll shape a clear plan, solve the practical challenges, and see the work through to delivery.</p><a class="c-link" href={withBase('/contact/')}>Tell us what you have in mind <ArrowUpRight size={16} /></a></header>
  <section class="p-wall-wrap" aria-label="Browse all services"><ServiceCatalog /></section>
  <section class="e-network-note p-container" aria-labelledby="network-title"><div><span class="p-eyebrow">HOW COLLABORATION BEGINS</span><h2 id="network-title">Your brief.<br /><em>The right conversation.</em></h2></div><div><p>From the first conversation to the final handover, we keep the work moving with clear communication and attention to detail.</p><p>Together, we agree the scope, schedule, budget, and review stages so you know what to expect. Any specialist requirements are clarified before work begins.</p><a class="c-button" href={withBase('/contact/')}>Start a Project <ArrowUpRight size={16} /></a></div></section>
</PlatformLayout>
