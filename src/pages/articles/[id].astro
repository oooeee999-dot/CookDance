---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { withBase } from '../../lib/urls';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { id: article.id }, props: { article, articles } }));
}

const { article, articles } = Astro.props;
const { Content } = await render(article);
const related = articles.filter((item: typeof article) => item.id !== article.id && (item.data.section === article.data.section || item.data.tags.some((tag: string) => article.data.tags.includes(tag)))).slice(0, 2);
---
<BaseLayout title={`${article.data.title} | CookDance`} description={article.data.description} image={article.data.image}>
  <article>
    <header class="article-header container"><div class="breadcrumbs"><a href={withBase('/')}>Home</a><span>/</span><a href={withBase(`/${article.data.section.toLowerCase().replace(' ', '-')}`)}>{article.data.section}</a><span>/</span><span>{article.data.category}</span></div><div class="article-title-block"><span class="kicker">{article.data.section.toUpperCase()} / {article.data.category.toUpperCase()}</span><h1>{article.data.title}</h1><p>{article.data.description}</p><div class="article-byline"><span>By CookDance Editorial</span><span class="byline-dot"></span><span>{article.data.readTime}</span></div></div></header>
    <div class="article-hero container"><img src={withBase(article.data.image)} alt={article.data.imageAlt} /></div>
    <div class="article-body-wrap container"><aside class="article-aside"><span class="kicker">IN THIS GUIDE</span><p>{article.data.category}</p><div class="article-tags">{article.data.tags.map((tag: string) => <span>{tag}</span>)}</div></aside><div class="article-prose"><Content /><div class="article-end"><span>✳</span><p>Keep learning. Keep cooking.</p></div></div></div>
  </article>
  {related.length > 0 && <section class="related-section container"><div class="section-heading"><div><span class="kicker">KEEP EXPLORING</span><h2>Related reading</h2></div><a class="text-link" href={withBase('/learn')}>View all <span aria-hidden="true">↗</span></a></div><div class="article-grid related-grid">{related.map((item: typeof article) => <ArticleCard article={item} index={3} />)}</div></section>}
</BaseLayout>
