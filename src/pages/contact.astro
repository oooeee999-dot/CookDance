---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import { brand, services, whatsappProjectUrl } from '../data/creative';
import { serviceCategories } from '../data/service-catalog';
import { ArrowUpRight } from '@lucide/astro';
---
<PlatformLayout title="Start a project" description="Tell CookDance about your idea. Get in touch for AI video, cinematic storytelling, and digital creative production.">
  <header class="c-page-heading p-container"><span class="p-eyebrow">START A PROJECT</span><h1>Every good collaboration<br /><em>starts somewhere.</em></h1><p>A rough idea is enough to begin. Tell us what you have in mind.</p><p class="e-contact-intro">Choose a service below and tell us what you want to achieve. We’ll work with you on a practical plan for delivery.</p></header>
  <section class="c-contact p-container" aria-label="Contact and project brief"><aside><h2>Let’s talk.</h2><a class="c-contact-link" href={`mailto:${brand.email}`}>{brand.email} <ArrowUpRight size={17} /></a><a class="c-contact-link" href={whatsappProjectUrl} target="_blank" rel="noopener noreferrer">WhatsApp · {brand.whatsappLabel} <ArrowUpRight size={17} /></a><p>Prefer a simple email? Write to us directly. Include a little about the idea, your timeline, and any references.</p><div class="c-contact-note"><strong>About this project brief</strong><p>This website does not send or store form submissions. Prepare your brief here, then send it using your email app or copy it into a message.</p></div></aside>
    <div><form id="project-brief" hidden><div class="c-form-row"><label>Name<input name="name" autocomplete="name" maxlength="100" required /></label><label>Email<input name="email" type="email" autocomplete="email" maxlength="254" required /></label></div><label>Service<select name="service" required><option value="">Choose a direction</option>{services.map(service => <option value={service.id}>{service.title}</option>)}<optgroup label="More service categories">{serviceCategories.map(category => <option value={category.id}>{category.title}</option>)}</optgroup><option value="other">Something else / Let’s discuss</option></select></label><label>Project Description<textarea name="description" rows="6" minlength="10" maxlength="6000" required placeholder="The idea, the audience, where it will appear, and when you need it…"></textarea></label><label>Budget <span class="c-optional">(optional)</span><input name="budget" maxlength="100" placeholder="A range, or something to discuss" /></label><button class="c-button" type="submit">Prepare project brief <ArrowUpRight size={16} /></button><p class="c-form-note">No automatic submission. You choose when and how to send.</p></form>
      <section class="c-brief-result" data-brief-result hidden aria-labelledby="brief-result-title"><h2 id="brief-result-title">Your brief is ready.</h2><p data-brief-status role="status">Nothing has been sent. Open an email draft, or copy the brief into your preferred email or messaging app.</p><div class="c-brief-actions"><a class="c-button" data-brief-mailto>Open email draft <ArrowUpRight size={15} /></a><button class="c-link" data-brief-copy type="button">Copy brief</button></div><label>Your prepared brief<textarea data-brief-preview rows="10" readonly></textarea></label><p class="c-form-note">Email app not configured? Copy the brief and send it to {brand.email}.</p></section>
      <noscript><p>You can contact us directly by email or WhatsApp using the links on this page. JavaScript is required only for preparing a project brief.</p></noscript>
    </div>
  </section>
</PlatformLayout>
