---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import PlatformPin from '../components/PlatformPin.astro';
import { stories, demoHref, type Section } from '../demo/content';
const collections: Record<string, { title: Section; description: string }> = {
  learn: { title: 'Learn', description: 'Ingredients, flavor, and everyday skills for a more curious kitchen.' },
  recipes: { title: 'Recipes', description: 'A thoughtful recipe collection is taking shape. Testing status will be stated clearly.' },
  'taste-lab': { title: 'Taste Lab', description: 'Explore the questions behind what happens when we cook.' },
  kitchen: { title: 'Kitchen', description: 'Tools, care, and choosing with purpose.' },
  stories: { title: 'Stories', description: 'Food, culture, and the way we gather around a table.' },
};
export function getStaticPaths() { return ['learn', 'recipes', 'taste-lab', 'kitchen', 'stories'].map(section => ({ params: { section } })); }
const collection = collections[Astro.params.section!];
const items = stories.filter(story => story.status === 'published' && story.section === collection.title);
---
<PlatformLayout wall title={collection.title} description={collection.description}>
  <h1 class="p-sr-only">{collection.title} — CookDance</h1>
  <section class="p-wall-wrap" data-home data-section={collection.title} aria-label={`${collection.title} collection`}>
    <div class="p-photo-wall" data-story-grid>{items.map((story, index) => <PlatformPin story={story} index={index} />)}</div>
    <div class="p-empty" data-empty hidden={items.length > 0}><h2>Good things take time.</h2><p>{collection.description}<br />Explore the ideas already on the table.</p><a href={demoHref()}>Discover CookDance</a></div>
  </section>
</PlatformLayout>
