---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import PlatformPin from '../components/PlatformPin.astro';
import ServiceCatalog from '../components/ServiceCatalog.astro';
import { brand, creativeCards, services } from '../data/creative';
import { withBase } from '../lib/urls';
import { ArrowUpRight, ArrowLeft, Bookmark } from '@lucide/astro';
---
<PlatformLayout wall>
  <section class="c-intro c-wide" aria-labelledby="intro-title">
    <div><span class="p-eyebrow">CAPABILITY × VITALITY</span><h1 id="intro-title">{brand.introduction}</h1><p>{brand.description}</p></div>
    <div class="c-intro-actions"><a class="c-link" href="#services">Explore Services <ArrowUpRight size={15} /></a><a class="c-button" href={withBase('/contact/')}>Start a Project <ArrowUpRight size={16} /></a></div>
  </section>
  <section class="p-wall-wrap c-work-wall" id="work" aria-label="Creative directions and visual studies">
    <div class="c-wall-caption"><span>SERVICE DIRECTIONS & VISUAL STUDIES</span><span>Ideas to explore together.</span></div>
    <div class="p-collection-state" data-creative-collection hidden><a class="p-icon" href={withBase('/#work')} aria-label="Back to all creative ideas"><ArrowLeft size={22} /></a><h2>Saved for a little later.</h2></div>
    <div class="p-photo-wall" data-creative-grid>{creativeCards.map((card,index) => <PlatformPin card={card} index={index} />)}</div>
    <div class="p-empty" data-creative-empty hidden><Bookmark size={28} stroke-width={1.2} /><h2>Keep an idea for later.</h2><p>Save a creative direction to come back to it.<br />Your collection stays in this browser.</p><a href={withBase('/#work')}>Explore all ideas</a></div>
    <p class="c-disclosure">These cards introduce our service directions and in-house visual studies. They are not completed client projects.</p>
  </section>
  <section class="c-section p-container" id="services" aria-labelledby="services-title">
    <div class="c-section-heading"><span class="p-eyebrow">WHAT WE CREATE</span><h2 id="services-title">A clear idea.<br /><em>Room to make it real.</em></h2><p>Three ways to begin. Each project starts with its own conversation.</p></div>
    <div class="c-service-list">{services.map(service => <article id={service.id} class="c-service-row"><span class="c-number">{service.number}</span><div><h3>{service.title}</h3><p>{service.description}</p><ul>{service.scope.map(item => <li>{item}</li>)}</ul></div><a class="c-link" href={withBase(`/contact/?service=${service.id}`)} aria-label={`Discuss ${service.title}`}>Let’s talk <ArrowUpRight size={18} /></a></article>)}</div>
    <a class="c-link e-all-services-link" href={withBase('/services/')}>Explore all 13 service categories <ArrowUpRight size={16} /></a>
  </section>
  <section class="c-section c-process p-container" id="process" aria-labelledby="process-title"><div class="c-section-heading"><span class="p-eyebrow">HOW WE WORK</span><h2 id="process-title">Made in conversation.</h2></div><ol>{[
    ['Share Your Idea','Tell us what you have in mind, who it is for, and where it needs to go.'],
    ['Plan the Production','Agree the creative direction, scope, budget, and delivery plan.'],
    ['Create & Refine','Develop the work and refine it through agreed review stages.'],
    ['Deliver the Work','Prepare the agreed assets and formats for your project.'],
  ].map(([title,text],i) => <li><span class="c-number">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
  <section class="c-project-invite p-container" aria-labelledby="project-invite-title"><div><span class="p-eyebrow">YOUR NEXT IDEA</span><h2 id="project-invite-title">Let’s make something<br /><em>worth sharing.</em></h2></div><a class="c-button" href={withBase('/contact/')}>Start a Project <ArrowUpRight size={17} /></a></section>
  <section class="e-home-expansion" id="service-network" aria-labelledby="expanded-services-title"><div class="e-expansion-heading"><div><span class="p-eyebrow">MORE WAYS TO WORK TOGETHER</span><h2 id="expanded-services-title">More possibilities.<br /><em>The same spirit.</em></h2><p>Tell us what you have in mind. We’ll work through the details, find practical solutions, and take care of your project from the first conversation to final delivery.</p></div><a class="c-link" href={withBase('/services/')}>View the full service directory <ArrowUpRight size={17} /></a></div><ServiceCatalog eager={false} /></section>
</PlatformLayout>
