---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft));
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== featured.id).slice(0, 3);
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span>A better way to cook, every day</div>
      <h1>Understand food.<br /><em>Enjoy cooking.</em></h1>
      <p>Clear ideas, useful skills, and a little more joy in the kitchen. CookDance is for anyone who wants to know <em>why</em> food works—not just what to do next.</p>
      <div class="hero-actions"><a class="button button-dark" href={withBase('/learn')}>Explore the guides <span aria-hidden="true">↗</span></a><a class="button button-plain" href={withBase('/about')}>Our approach <span aria-hidden="true">→</span></a></div>
      <div class="hero-note"><span class="note-circle">01</span><span>Learn the fundamentals.<br />Make them your own.</span></div>
    </div>
    <div class="hero-visual"><img src={withBase('/images/hero.jpg')} alt="Fresh ingredients and cookware arranged on a kitchen table" fetchpriority="high" /><div class="image-caption"><span>THE COOKDANCE EDIT</span><span>Ingredients • Technique • Everyday life</span></div></div>
  </section>

  <section class="section-intro container" aria-labelledby="explore-title"><div><span class="kicker">EXPLORE COOKDANCE</span><h2 id="explore-title">A kitchen is a place<br />to keep learning.</h2></div><p>From the first cut to the final taste, small decisions shape every meal. Choose a path and build confidence one useful idea at a time.</p></section>
  <section class="path-grid container" aria-label="Explore topics">
    <a class="path-card path-learn" href={withBase('/learn')}><span class="path-number">01 / THE BASICS</span><div><h3>Learn</h3><p>Simple skills with lasting value.</p><span class="circle-arrow" aria-hidden="true">↗</span></div></a>
    <a class="path-card path-lab" href={withBase('/taste-lab')}><span class="path-number">02 / THE WHY</span><div><h3>Taste Lab</h3><p>Understand what happens when you cook.</p><span class="circle-arrow" aria-hidden="true">↗</span></div></a>
    <a class="path-card path-kitchen" href={withBase('/kitchen')}><span class="path-number">03 / THE TOOLS</span><div><h3>Kitchen</h3><p>Choose and use tools with purpose.</p><span class="circle-arrow" aria-hidden="true">↗</span></div></a>
  </section>

  <section class="featured-section"><div class="container featured-grid"><div class="featured-image"><img src={withBase(featured.data.image)} alt={featured.data.imageAlt} loading="lazy" /></div><div class="featured-copy"><span class="kicker">FEATURED GUIDE / {featured.data.category.toUpperCase()}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><div class="featured-bottom"><span>{featured.data.readTime} · {featured.data.tags.slice(0, 2).join(' / ')}</span><a class="button button-outline" href={withBase(`/articles/${featured.id}`)}>Read the guide <span aria-hidden="true">↗</span></a></div></div></div></section>

  <section class="latest-section container"><div class="section-heading"><div><span class="kicker">FROM THE JOURNAL</span><h2>Ideas for your next meal.</h2></div><a class="text-link" href={withBase('/learn')}>Explore all articles <span aria-hidden="true">↗</span></a></div><div class="article-grid">{latest.map((article, index) => <ArticleCard article={article} index={index} />)}</div></section>

  <section class="closing-section container"><div class="closing-icon" aria-hidden="true">✳</div><span class="kicker">THE COOKDANCE WAY</span><h2>Cook with curiosity.<br /><em>Eat with pleasure.</em></h2><p>Recipes are a starting point. Understanding ingredients, heat, flavor, and tools helps you make every meal your own.</p><a class="button button-light" href={withBase('/about')}>Get to know us <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
